# ═══════════════════════════════════════════════════════════
# Genasis Server Stack — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ─── Domain Settings ──────────────────────────────────────
PLANE_DOMAIN=plane.example.com
MM_DOMAIN=mm.example.com
PLANE_PORT=38381
MM_PORT=38385

# ─── Plane ────────────────────────────────────────────────
APP_RELEASE=v1.2.3
PLANE_POSTGRES_USER=plane
PLANE_POSTGRES_PASSWORD=CHANGE_ME_plane_db_password
PLANE_SECRET_KEY=CHANGE_ME_random_60_char_string

# ─── Mattermost ──────────────────────────────────────────
MATTERMOST_IMAGE_TAG=10.11.8
MM_POSTGRES_USER=mmuser
MM_POSTGRES_PASSWORD=CHANGE_ME_mm_db_password

# ─── Timezone ─────────────────────────────────────────────
TZ=Asia/Seoul
