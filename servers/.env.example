# ═══════════════════════════════════════════════════════════
# Genasis Server Stack — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
#
#   ./scripts/setup-user-env.sh           # auto-generated values
#   cp .env.example .env && $EDITOR .env  # manual
#
# Multi-tenant: when several operators share one host, every variable
# below MUST be unique per operator. The helper script handles this for
# you (UID-derived port offset + openssl-generated secrets).

# ─── Multi-tenant isolation ───────────────────────────────
# Namespaces every container/network/volume so two operators on the
# same host never collide. Defaults to "genasis-${USER}". Override only
# if you intentionally want shared volumes (very unusual).
COMPOSE_PROJECT_NAME=genasis-CHANGE_ME

# ─── Domain Settings ──────────────────────────────────────
# Each operator should pick a distinct subdomain (e.g.
# alice-plane.example.com, bob-plane.example.com) so Caddy can route
# them independently.
PLANE_DOMAIN=plane.example.com
MM_DOMAIN=mm.example.com

# ─── Externally-exposed host ports ────────────────────────
# These are the ONLY ports bound to the host from this stack. Pick a
# block that does not collide with other operators' stacks. Convention:
#   38400 + offset   →  Plane proxy
#   38500 + offset   →  Mattermost
#    3100 + offset   →  trial-app (consumed by trial-app/.env)
PLANE_PORT=38381
MM_PORT=38385
TRIAL_APP_PORT=3000

# ─── Plane ────────────────────────────────────────────────
APP_RELEASE=v1.2.3
PLANE_POSTGRES_USER=plane
PLANE_POSTGRES_PASSWORD=CHANGE_ME_plane_db_password
PLANE_SECRET_KEY=CHANGE_ME_random_60_char_string

# ─── Mattermost ──────────────────────────────────────────
MATTERMOST_IMAGE_TAG=10.11.8
MM_POSTGRES_USER=mmuser
MM_POSTGRES_PASSWORD=CHANGE_ME_mm_db_password

# ─── trial-app bridge (mirrored to trial-app/.env by the helper) ──
# These bridge the Rust providers (TrialMattermost / TrialPlane) to the
# trial-app HTTP endpoints — see ADR-013. shared_secret must match
# TRIAL_SHARED_SECRET in trial-app/.env exactly.
TRIAL_SHARED_SECRET=CHANGE_ME_trial_shared_secret
WEBHOOK_SHARED_SECRET=CHANGE_ME_webhook_shared_secret

# ─── Timezone ─────────────────────────────────────────────
TZ=Asia/Seoul
