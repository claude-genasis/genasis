#!/usr/bin/env bash
# Genasis PostToolUse hook — when a Bash tool call performed a `git commit`,
# post a one-liner on the issue's Mattermost thread (best effort).
#
# Reads a JSON envelope on stdin from Claude Code with `tool_input.command`.

set -euo pipefail
input="$(cat)"
case "$input" in
  *"git commit"*)
    : ;;
  *)
    exit 0 ;;
esac

if [ -z "${MM_URL:-}" ] || [ -z "${MM_TOKEN_PM:-}" ] || [ -z "${MM_SCRUM_CHANNEL_ID:-}" ]; then
  exit 0
fi

last_msg="$(git log -1 --pretty=%s 2>/dev/null || true)"
[ -z "$last_msg" ] && exit 0

curl -fsS -X POST "$MM_URL/api/v4/posts" \
  -H "Authorization: Bearer $MM_TOKEN_PM" \
  -H "Content-Type: application/json" \
  -d "$(printf '{"channel_id":"%s","message":"\\u26a1 commit: %s"}' \
    "$MM_SCRUM_CHANNEL_ID" "${last_msg//\"/\\\"}")" >/dev/null 2>&1 || true
