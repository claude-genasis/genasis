# trial-app environment — consumed by trial-app/docker-compose.yml.
#
# Multi-tenant ops: run servers/scripts/setup-user-env.sh, which writes
# servers/.env AND this file with matching COMPOSE_PROJECT_NAME, port
# offset, and TRIAL_SHARED_SECRET so the Rust providers can reach this
# trial-app over the bridge.

# ─── Multi-tenant isolation ───────────────────────────────
COMPOSE_PROJECT_NAME=genasis-CHANGE_ME

# ─── Externally-exposed host port ─────────────────────────
# Convention: 3100 + UID%50. Pick the same TRIAL_APP_PORT as in
# servers/.env so the Rust trial provider hits the right instance.
TRIAL_APP_PORT=3000

# ─── Trial bridge auth ────────────────────────────────────
# MUST match servers/.env TRIAL_SHARED_SECRET — this is the
# X-Genasis-Trial-Secret header that genasis Rust providers send.
TRIAL_SHARED_SECRET=CHANGE_ME_trial_shared_secret

# ─── Optional Mattermost notification (signup form) ───────
# Leave blank to silently skip notifications.
MM_BOT_TOKEN=
MM_TRIAL_CHANNEL_ID=
MM_BASE_URL=https://mm.realstory.blog

# ─── Webhook auth (admin credential delivery) ────────────
WEBHOOK_SHARED_SECRET=CHANGE_ME_webhook_shared_secret
