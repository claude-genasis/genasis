# Rust build artifacts
/target/
**/*.rs.bk
Cargo.lock.bak

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment / secrets
.env
.env.local
.env.agents
*.pem
*.key

# Test artifacts
/coverage/
*.profraw
tarpaulin-report.html

# OS
Thumbs.db

# Local sandbox / scratch
/tmp/
*.tmp
*.log
*.bak

# install.sh local download cache
.genasis-download-cache/

# Node sub-process (Plane provisioning) deps
crates/genasis-cli/scripts/node_modules/

# agents-pool is a private submodule (registered in .gitmodules).
# Users without access simply get an empty directory on clone.
# Do NOT add agents-pool/ to .gitignore — submodules need index tracking.

# agents/base/ does NOT belong in public repo — base agents are
# distributed only via release tarballs built by agents-pool.
agents/base/
crates/genasis-cli/scripts/package-lock.json

# Migration backups produced by `genasis migrate-from-genesis`
.genasis-migration-backup-*/

# Snapshot / backup files produced by overlay engine
*.genasis-backup-*

# Ad-hoc local artifacts left over from copy
tmp.mmd

# Claude Code session artifacts (created when claude is launched in this
# directory; not part of the source).
/.claude/
