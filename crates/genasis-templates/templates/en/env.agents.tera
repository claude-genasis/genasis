# .env.agents — generated by genasis. Add to .gitignore.
# Holds per-agent Plane PATs and Mattermost bot tokens.

PLANE_URL="{{ plane_url }}"
PLANE_WORKSPACE_SLUG="{{ plane_workspace_slug }}"
{% if plane_project_id %}PLANE_PROJECT_ID="{{ plane_project_id }}"{% endif %}

MM_URL="{{ mm_url }}"
MM_TEAM_NAME="{{ mm_team_name }}"
{% if mm_scrum_channel_id %}MM_SCRUM_CHANNEL_ID="{{ mm_scrum_channel_id }}"{% endif %}

{# per-agent PATs / bot tokens / user UUIDs are filled in during `genasis init`'s Plane / MM provisioning step. M3+M4. #}
{% for role in agent_roles %}
PLANE_TOKEN_{{ role | upper }}=""
MM_TOKEN_{{ role | upper }}=""
PLANE_USER_ID_{{ role | upper }}=""
{% endfor %}
