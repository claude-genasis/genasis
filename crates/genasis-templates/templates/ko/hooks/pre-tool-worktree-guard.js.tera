#!/usr/bin/env node
// Genasis PreToolUse hook — in parallel-worktree mode (GENASIS_WORKTREE
// env var set), refuse `git checkout -b` invocations issued from the
// shared /work tree, since each role agent should work inside its own
// /tmp/<project>-<role>/ worktree.

const chunks = [];
process.stdin.on("data", (c) => chunks.push(c));
process.stdin.on("end", () => {
    let input;
    try {
        input = JSON.parse(Buffer.concat(chunks).toString("utf8"));
    } catch {
        process.exit(0);
    }
    if (!process.env.GENASIS_WORKTREE) process.exit(0);
    const cmd = (input?.tool_input?.command ?? "").toLowerCase();
    if (!/\bgit\s+checkout\s+-b\b/.test(cmd)) process.exit(0);
    if (process.cwd().startsWith("/tmp/")) process.exit(0);

    console.error(
        "[genasis] BLOCKED: `git checkout -b` outside the role worktree. " +
            "Switch to /tmp/<project>-<role>/ or unset GENASIS_WORKTREE.",
    );
    process.exit(2);
});
